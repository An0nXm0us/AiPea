<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <!-- Animated ImageView -->
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="32dp"
        android:scaleType="fitCenter"
        android:alpha="0.9"
        android:elevation="8dp"
        android:background="@drawable/image_circle_background"
        android:padding="8dp"
        app:srcCompat="@drawable/academic" />

    <!-- Styled TextView with shadow and better typography -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Eddie"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="42sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.02"
        android:lineSpacingExtra="4sp"
        android:shadowColor="#80000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:layout_marginBottom="48dp"
        android:padding="12dp"
        android:background="@drawable/text_highlight" />

    <!-- Enhanced Button with ripple effect and icon -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/startBtn"
        android:layout_width="320dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/white"
        android:elevation="6dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="@color/green"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.01"
        android:drawablePadding="8dp"
        app:icon="@drawable/baseline_arrow_forward_24"
        app:iconGravity="textEnd"
        app:iconTint="@color/green"
        app:cornerRadius="30dp"
        app:rippleColor="@color/light_green"
        style="@style/Widget.Material3.Button.ElevatedButton" />

    <!-- Additional decorative elements -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to your learning journey"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.03"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/baseline_school_24" />

</LinearLayout>